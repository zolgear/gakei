# =============================================================================
#  GAKEI の環境変数(日本語版。正は .env.example)
# =============================================================================
#  このファイルをリポジトリ直下に `.env` としてコピーして編集する。`.env` はコミットしない。
#  通常は何も設定しなくてよい。OpenAI の API キーは起動後の設定画面から登録できる。
#  各項目の説明と優先順位: docs/configuration.md
#
#  この書式の読み方:
#    # 文章        説明
#    #KEY=value    無効な設定。書いてある値は既定値。先頭の `#` を消すと有効になる
#    KEY=value     有効な設定
# =============================================================================


# -----------------------------------------------------------------------------
#  1. OpenAI
# -----------------------------------------------------------------------------

# API キー。空のままなら設定画面で保存したキーを使う。
# ここに書くとこちらが優先され、設定画面からは変更できなくなる。
OPENAI_API_KEY=

# OpenAI 互換 API(LiteLLM などのプロキシ)の接続先。空なら OpenAI 本体。
# 通常は /v1 まで含める。ここに書くと設定画面で保存した値より優先する。
#OPENAI_BASE_URL=http://127.0.0.1:4000/v1

# 429 などの再試行回数(OpenAI SDK が行う)と、1リクエストのタイムアウト(秒)。
# 4K・高画質は数分かかる。
#OPENAI_MAX_RETRIES=4
#OPENAI_TIMEOUT_SECONDS=600

# Generate のときに送る表現の制限(`auto` か `low`)。
# 設定 → 生成 で保存した値があればそちらが優先する。
#MODERATION=low


# -----------------------------------------------------------------------------
#  2. 保存先とサーバー
# -----------------------------------------------------------------------------

# 画像、secrets.json(設定画面で保存したキー・接続先)の置き場所。DATABASE_URL を
# 指定しない場合は、ここに SQLite のファイルも置く。絶対パスで書く。既定は ./data
#DATA_DIR=/home/you/gakei-data

# 待ち受けるアドレスとポート。認証なし(既定)のときは HOST を 127.0.0.1 のままにして、
# この PC からだけ開けるようにしておく。
#HOST=127.0.0.1
#PORT=8000

# 既定の SQLite の代わりに PostgreSQL を使う場合(ADR-0027、15以上、docs/postgresql.md)。
# PostgreSQL を使う場合も、画像のために上の DATA_DIR は引き続き必要。リポジトリの
# compose.yaml を使う場合は、これは指定せず POSTGRES_PASSWORD だけ指定する(コンテナ
# 側でこの値を組み立てる)。
#DATABASE_URL=postgresql://gakei:password@127.0.0.1:5432/gakei

# リポジトリの compose.yaml に同梱した PostgreSQL のパスワード。同梱の PostgreSQL を
# 使う場合は必須(未指定だと docker compose が起動しない)。DATABASE_URL を直接指定する
# 場合や SQLite を使う場合は使わない。URL に埋め込むので、英数字だけにする(@ / : # などの
# 記号が入ると接続できない)。
#POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
#  3. ComfyUI(実験的)
# -----------------------------------------------------------------------------

# ローカルの ComfyUI。通常は 設定 → ComfyUI から接続する。ここに書いた値は、画面で
# 接続・切り離しをするまでの初期値としてだけ使われる。
#COMFYUI_URL=http://127.0.0.1:8188
#COMFYUI_TIMEOUT_SECONDS=1800


# -----------------------------------------------------------------------------
#  4. 認証(ADR-0019)
# -----------------------------------------------------------------------------

# `none`(既定): 個人モード。ログインなしで、すべての操作ができる。
# `oidc`: OpenID Connect の発行者(Google、Keycloak など)でログインする。
# 手順: docs/auth.md
#AUTH_MODE=none

# --- AUTH_MODE=oidc のとき必須 ---

# 発行者の URL。Google: https://accounts.google.com
# Keycloak: https://keycloak.example.com/realms/<レルム名>
#OIDC_ISSUER=https://accounts.google.com

# 発行者に登録したクライアント ID とシークレット。public client(PKCE のみ)なら
# シークレットは空にする。
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=

# 利用者がブラウザで開く URL。発行者に登録するリダイレクト URI は
# {PUBLIC_BASE_URL}/api/auth/callback。実際に開く URL と一致させる
# (`127.0.0.1` と `localhost` は別物)。https なら Cookie に `Secure` が付く。
#PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- 誰がログインでき、誰が管理者か ---

# 管理者(カンマ区切りのメールアドレス。大文字小文字は無視)。管理者は管理者設定
# (API キー、接続先、生成、ComfyUI)を変えられる。それ以外の人は一般ユーザー。
#AUTH_ADMIN_EMAILS=you@example.com

# ログインを許すメールアドレスのドメイン(カンマ区切り)。空なら発行者が認証した人は
# 誰でも。Google のように誰でもアカウントを作れる発行者では必ず指定する(指定しないと
# 世界中の誰でも一般ユーザーとしてログインできる)。管理者は常に許される。
#AUTH_ALLOWED_EMAIL_DOMAINS=example.com

# --- 任意 ---

#OIDC_SCOPES=openid profile email

# セッションの有効期間(時間)。1〜720(30日)の範囲。
#AUTH_SESSION_HOURS=12

# ログイン手続き中の一時 Cookie の署名鍵。空なら自動生成して DATA_DIR/secrets.json に保存する。
#AUTH_SECRET=
