# =============================================================================
#  GAKEI environment variables
# =============================================================================
#  Copy this file to `.env` at the repository root and edit it. Never commit `.env`.
#  Usually you don't need any of this: the OpenAI API key can be registered from
#  the Settings screen after startup. Details and precedence: docs/configuration.md
#  Japanese version: .env.example.ja
#
#  How to read this file:
#    # text        explanation
#    #KEY=value    a setting that is OFF; the value shown is the default.
#                  Remove the leading `#` to enable it.
#    KEY=value     a setting that is ON
# =============================================================================


# -----------------------------------------------------------------------------
#  1. OpenAI
# -----------------------------------------------------------------------------

# API key. Leave empty to use the key saved from the Settings screen.
# A value here takes precedence and locks the Settings screen.
OPENAI_API_KEY=

# Base URL of an OpenAI-compatible API (e.g. a LiteLLM proxy). Empty = OpenAI itself.
# Usually includes /v1. A value here takes precedence over the Settings screen.
#OPENAI_BASE_URL=http://127.0.0.1:4000/v1

# Retries for 429 etc. (done by the OpenAI SDK) and per-request timeout in seconds.
# 4K / high-quality images can take several minutes.
#OPENAI_MAX_RETRIES=4
#OPENAI_TIMEOUT_SECONDS=600

# Content moderation level sent with Generate (`auto` or `low`).
# A value saved in Settings → Generation takes precedence over this.
#MODERATION=low


# -----------------------------------------------------------------------------
#  2. Storage and server
# -----------------------------------------------------------------------------

# Where images and secrets.json (key / base URL saved from the Settings screen) are
# stored. When DATABASE_URL is unset, the SQLite database also lives here. Use an
# absolute path. Default: ./data
#DATA_DIR=/home/you/gakei-data

# Listen address and port. With no authentication (the default), keep HOST at
# 127.0.0.1 so only this machine can open GAKEI.
#HOST=127.0.0.1
#PORT=8000

# PostgreSQL instead of the default SQLite (ADR-0027, 15+, docs/postgresql.md).
# DATA_DIR above is still required for images. With the repository's compose.yaml,
# leave this unset and set POSTGRES_PASSWORD instead (the container fills this in).
#DATABASE_URL=postgresql://gakei:password@127.0.0.1:5432/gakei

# Password for the PostgreSQL service bundled in the repository's compose.yaml.
# Required when using that file with PostgreSQL (docker compose refuses to start
# without it). Not used when DATABASE_URL is set directly, or with SQLite.
# Use only letters and digits: it is embedded in a URL, so symbols such as @ / : # break it.
#POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
#  3. ComfyUI (experimental)
# -----------------------------------------------------------------------------

# A local ComfyUI. Normally connect from Settings → ComfyUI instead; these are only
# the initial values used until you connect or detach from the screen.
#COMFYUI_URL=http://127.0.0.1:8188
#COMFYUI_TIMEOUT_SECONDS=1800


# -----------------------------------------------------------------------------
#  4. Authentication (ADR-0019, ADR-0034)
# -----------------------------------------------------------------------------

# Usually you configure authentication in the admin settings ("Authentication"
# page) without a restart. The values below are only initial values: settings
# saved on that page take precedence. Setup guide: docs/auth.md

# `none` (default): personal mode, no login, everything is allowed.
# `oidc`: login through an OpenID Connect provider (Google, Keycloak, ...).
# Leave this unset to switch the mode on the settings page. When set, it
# overrides the page (the switch is locked). Emergency: if nobody can log in,
# set AUTH_MODE=none and restart; the saved settings are kept.
#AUTH_MODE=none

# --- Required for oidc (here or on the settings page) ---

# Issuer URL. Google: https://accounts.google.com
# Keycloak: https://keycloak.example.com/realms/<realm>
#OIDC_ISSUER=https://accounts.google.com

# Client ID and secret registered at the provider. Leave the secret empty for a
# public client (PKCE only). Once the connection is saved on the settings page,
# the secret is read only from DATA_DIR/secrets.json and this value is ignored.
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=

# The URL users open in the browser. The redirect URI registered at the provider
# must be {PUBLIC_BASE_URL}/api/auth/callback. Must match what you actually open
# (`127.0.0.1` and `localhost` are different). https adds `Secure` to the cookie.
#PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Who may log in, and who is an admin ---

# Admins (comma-separated e-mail addresses, case-insensitive). Admins can change
# admin settings (API key, base URL, generation, ComfyUI). Everyone else is a user.
#AUTH_ADMIN_EMAILS=you@example.com

# E-mail domains allowed to log in (comma-separated). Empty = anyone the provider
# authenticates. ALWAYS set this with providers where anyone can create an account
# (e.g. Google); otherwise the whole world can log in as a user. Admins are always allowed.
#AUTH_ALLOWED_EMAIL_DOMAINS=example.com

# --- Optional ---

#OIDC_SCOPES=openid profile email

# Session lifetime in hours. Must be between 1 and 720 (30 days).
#AUTH_SESSION_HOURS=720

# Signing key for the short-lived login cookie. Generated automatically and stored in
# DATA_DIR/secrets.json when empty. Not configurable on the settings page.
#AUTH_SECRET=
